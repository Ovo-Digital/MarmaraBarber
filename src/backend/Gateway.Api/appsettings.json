{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": "",
    "Redis": ""
  },
  "Shopify": {
    "StoreUrl": "",
    "StorefrontAccessToken": "",
    "AdminAccessToken": "",
    "ApiVersion": "2025-01",
    "WebhookSecret": ""
  },
  "Jwt": {
    "Issuer": "https://headless-commerce.local",
    "Audience": "headless-commerce-clients",
    "SigningKey": "change-me-to-a-long-random-secret-at-least-32-chars"
  },
  "ApiKey": "change-me-internal-api-key",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1m", "Limit": 120 }
    ]
  }
}
