# ============================================================
# Marmara Barber - environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Shopify ---
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=
# OAuth app (Partner/Dev Dashboard) — vitrin için yeterli DEĞİL, token da gerekir
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Database (SQL Server) ---
SQL_CONNECTION=Server=sqlserver,1433;Database=MarmaraBarber;User Id=sa;Password=Your_Strong_Passw0rd!;TrustServerCertificate=True;
MSSQL_SA_PASSWORD=Your_Strong_Passw0rd!

# --- Redis ---
REDIS_CONNECTION=redis:6379

# --- Auth / Security ---
JWT_ISSUER=https://marmara-barber.local
JWT_AUDIENCE=marmara-barber-clients
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-at-least-32-chars
API_KEY=change-me-internal-api-key

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=marmara-barber-bff
SERILOG_MINIMUM_LEVEL=Information

# --- Frontend (Next.js) ---
NEXT_PUBLIC_SHOPIFY_STORE_URL=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-07
# direct = Shopify Storefront API (Vercel için) | bff = ASP.NET BFF
NEXT_PUBLIC_DATA_SOURCE=direct
NEXT_PUBLIC_BFF_URL=http://localhost:8080
# Server-side token (Vercel'de SHOPIFY_STOREFRONT_TOKEN kullanın, client'a koymayın)
SHOPIFY_STOREFRONT_TOKEN=

# --- ERP (example: generic) ---
ERP_PROVIDER=Nebim
ERP_BASE_URL=
ERP_API_KEY=

# --- CRM ---
CRM_PROVIDER=Hubspot
CRM_BASE_URL=
CRM_API_KEY=

# --- Marketing ---
MARKETING_PROVIDER=Klaviyo
MARKETING_API_KEY=
