FROM node:20-alpine AS deps
WORKDIR /app
COPY src/frontend/storefront-next/package*.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY src/frontend/storefront-next/ ./
ARG NEXT_PUBLIC_BFF_URL=http://localhost:8080
ARG NEXT_PUBLIC_SHOPIFY_STORE_URL
ARG NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN
ARG NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-01
ENV NEXT_PUBLIC_BFF_URL=$NEXT_PUBLIC_BFF_URL
ENV NEXT_PUBLIC_SHOPIFY_STORE_URL=$NEXT_PUBLIC_SHOPIFY_STORE_URL
ENV NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=$NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN
ENV NEXT_PUBLIC_SHOPIFY_API_VERSION=$NEXT_PUBLIC_SHOPIFY_API_VERSION
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
EXPOSE 3000
ENV PORT=3000
CMD ["node", "server.js"]
